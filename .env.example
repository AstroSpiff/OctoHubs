# Core security
SECRET_KEY=change-this-secret-key
PASSWORD_SECRET=change-this-password-secret
# Set only while rotating PASSWORD_SECRET; remove after a successful restart.
PASSWORD_SECRET_PREVIOUS=
WEBHOOK_IP_WHITELIST=
# Keep true only behind a proxy that overwrites X-Real-IP (the bundled Nginx does).
WEBHOOK_TRUST_PROXY_HEADERS=true
SESSION_TIMEOUT_MINUTES=60
CSRF_TIME_LIMIT_SECONDS=3600
SESSION_COOKIE_SECURE=true
LOGIN_TRUST_PROXY_HEADERS=true
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
LOGIN_RATE_LIMIT_IP_ATTEMPTS=20
LOGIN_RATE_LIMIT_USERNAME_ATTEMPTS=5
STREAMS_REFRESH_SECONDS=15

# Containers run as a non-root user. Persistent app paths must be writable by it.
OCTOHUBS_UID=1000
OCTOHUBS_GID=1000

# Used only with docker-compose.direct.yml for explicit local HTTP access.
OCTOHUBS_DIRECT_BIND_ADDRESS=127.0.0.1
OCTOHUBS_DIRECT_PORT=5050

# Required initial administrator. It is created only while the user table is empty.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-admin-password
ADMIN_EMAIL=admin@example.com
# Preferred Docker-secret source; use with docker-compose.admin-bootstrap.yml.
# ADMIN_PASSWORD_FILE=./secrets/octohubs_admin_password

# Required shared PostgreSQL database
OCTOHUBS_DB_HOST=postgres
OCTOHUBS_DB_PORT=5432
OCTOHUBS_DB_NAME=octohubs
OCTOHUBS_DB_USER=octohubs
OCTOHUBS_DB_PASSWORD=change-this-database-password
# Alternative for docker-compose.secrets.yml; do not store the secret itself here.
# OCTOHUBS_DB_PASSWORD_FILE=./secrets/octohubs_db_password
OCTOHUBS_DB_DRIVER=postgresql+psycopg2
OCTOHUBS_DB_PARAMS=
# OCTOHUBS_DB_URL=postgresql+psycopg2://octohubs:change-this-database-password@postgres:5432/octohubs

# Optional one-time source for importing a retired SQLite auth database
OCTOHUBS_LEGACY_AUTH_SQLITE_PATH=
