# Core security
FLASK_SECRET_KEY=change-this-secret-key
WEBHOOK_SECRET=change-this-webhook-secret
WEBHOOK_IP_WHITELIST=
SESSION_TIMEOUT_MINUTES=60
CSRF_TIME_LIMIT_SECONDS=3600
SESSION_COOKIE_SECURE=true
STREAMS_REFRESH_SECONDS=15

# Default admin user (change on first run)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-admin-password
ADMIN_EMAIL=admin@example.com

# Authentication database (SQLite default)
AUTH_DATABASE_URL=sqlite:////app/data/auth.db

# PostgreSQL (optional)
POSTGRES_DB=octohub
POSTGRES_USER=octohub
POSTGRES_PASSWORD=change-this-postgres-password

# If you want to use PostgreSQL for auth, uncomment and set:
# AUTH_DATABASE_URL=postgresql+psycopg2://octohub:change-this-postgres-password@postgres:5432/octohub
