# Optional local/CLI template. Portainer users can set the same values directly
# in the stack and do not need to deploy this file.

# Core security. Docker replaces these known placeholders with generated values
# persisted in /config/.env; keep /config writable and persistent. Any explicit
# non-placeholder SECRET_KEY must contain at least 32 non-trivial UTF-8 bytes.
SECRET_KEY=change-this-secret-key
PASSWORD_SECRET=change-this-password-secret
# Set only while rotating PASSWORD_SECRET; remove after a successful restart.
PASSWORD_SECRET_PREVIOUS=
WEBHOOK_IP_WHITELIST=
# Enable only behind a trusted external proxy that overwrites forwarded headers.
WEBHOOK_TRUST_PROXY_HEADERS=false
# Required with WEBHOOK_TRUST_PROXY_HEADERS=true; list only direct proxy networks.
WEBHOOK_TRUSTED_PROXY_CIDRS=
SESSION_TIMEOUT_MINUTES=60
CSRF_TIME_LIMIT_SECONDS=3600
# Maximum ordinary HTTP request body (64 KiB..6 MiB); image uploads retain a
# fixed 6 MiB transport budget and are validated again after decoding.
OCTOHUBS_MAX_REQUEST_BODY_BYTES=1048576
SESSION_COOKIE_SECURE=false
# Exact browser origin when external TLS/proxying changes the WebSocket scheme.
# Example: https://octohubs.example.com
OCTOHUBS_PUBLIC_ORIGIN=
LOGIN_TRUST_PROXY_HEADERS=false
# Required with LOGIN_TRUST_PROXY_HEADERS=true; list only direct proxy networks.
LOGIN_TRUSTED_PROXY_CIDRS=
API_TOKEN_RATE_LIMIT_PER_MINUTE=600
API_TOKEN_PREAUTH_RATE_LIMIT_PER_MINUTE=120
# Enable only when the direct proxy overwrites client-address headers.
API_TOKEN_TRUST_PROXY_HEADERS=false
API_TOKEN_TRUSTED_PROXY_CIDRS=
SERVICE_CONNECTION_CHECK_COOLDOWN_SECONDS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
LOGIN_RATE_LIMIT_IP_ATTEMPTS=20
LOGIN_RATE_LIMIT_USERNAME_ATTEMPTS=5
STREAMS_REFRESH_SECONDS=15
# Maximum concurrent authenticated connections per user and realtime channel.
OCTOHUBS_REALTIME_CONNECTIONS_PER_CHANNEL=3
# Authenticated Event Bridge WebSocket leases (global and per Emby server).
OCTOHUBS_EVENT_BRIDGE_CONNECTIONS_GLOBAL=64
OCTOHUBS_EVENT_BRIDGE_CONNECTIONS_PER_SERVER=3

# Containers run as a non-root user. Persistent app paths must be writable by it.
OCTOHUBS_UID=1000
OCTOHUBS_GID=1000

# HTTP listener published by docker-compose.yml. Keep loopback unless an external
# network boundary or reverse proxy requires another host address.
OCTOHUBS_BIND_ADDRESS=127.0.0.1
OCTOHUBS_PORT=5050

# Initial administrator bootstrap. It is created only while the user table is
# empty; remove these ADMIN_* values after the first successful login.
ADMIN_USERNAME=admin
# Required for the first bootstrap: set a unique value; public example values are rejected.
ADMIN_PASSWORD=
ADMIN_EMAIL=admin@example.com
# Preferred Docker-secret source; use with docker-compose.admin-bootstrap.yml.
# ADMIN_PASSWORD_FILE=./secrets/octohubs_admin_password

# Required operator-managed PostgreSQL database. OctoHubs does not provision it.
OCTOHUBS_DB_HOST=database.example.internal
OCTOHUBS_DB_PORT=5432
OCTOHUBS_DB_NAME=octohubs
OCTOHUBS_DB_USER=octohubs
OCTOHUBS_DB_PASSWORD=change-this-database-password
# Alternative for docker-compose.secrets.yml; do not store the secret itself here.
# OCTOHUBS_DB_PASSWORD_FILE=./secrets/octohubs_db_password
OCTOHUBS_DB_DRIVER=postgresql+psycopg2
OCTOHUBS_DB_PARAMS=
# Local fail-fast deadlines. URL query parameters connect_timeout/options take precedence.
OCTOHUBS_DB_CONNECT_TIMEOUT_SECONDS=5
OCTOHUBS_DB_STATEMENT_TIMEOUT_MS=30000
# OCTOHUBS_DB_URL=postgresql+psycopg2://octohubs:change-this-database-password@database.example.internal:5432/octohubs

# Persistent directory for application-generated secrets inside the container
OCTOHUBS_CONFIG_DIR=/config
