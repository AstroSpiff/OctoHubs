{% if trakt_rating %}{% set ns.ratings = ns.ratings + ['<b>' ~ trakt_rating ~ '</b> <a href="' ~ trakt_url ~ '">Trakt</a>'] %}{% endif %}
{% if imdb_rating %}{% set ns.ratings = ns.ratings + ['<b>' ~ imdb_rating ~ '</b> <a href="' ~ imdb_url ~ '">IMDb</a>'] %}{% endif %}
{% if metacritic_rating %}
{% set meta10 = (metacritic_rating|float / 10) %}
{% set meta10_text = '%.1f'|format(meta10) %}
{% set ns.ratings = ns.ratings + ['<b>' ~ meta10_text ~ '</b> MetaCritic'] %}
{% endif %}
