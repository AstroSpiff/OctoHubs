{% macro pick_audio(version) -%}
{%- set candidates = [] -%}
{%- if version.audio_details -%}
  {%- set candidates = version.audio_details.split(' · ') -%}
{%- elif version.audio_langs -%}
  {%- set candidates = version.audio_langs.split(',') -%}
{%- elif version.audio_ita -%}
  {%- set candidates = [version.audio_ita] -%}
{%- endif -%}

{%- set ns = namespace(selected=None) -%}
{%- for a in candidates -%}
  {%- set a_clean = a|trim -%}
  {%- set a_low = a_clean|lower -%}
  {%- if ns.selected is none and ('ita' in a_low or 'italiano' in a_low or 'italian' in a_low) -%}
    {%- set ns.selected = a_clean -%}
  {%- endif -%}
{%- endfor -%}

{%- if ns.selected is none and candidates|length -%}
  {%- set ns.selected = candidates[0]|trim -%}
{%- endif -%}
{{- ns.selected -}}
{%- endmacro %}
{% if type == 'movie' %}
{{ tmdb_poster_url }}
