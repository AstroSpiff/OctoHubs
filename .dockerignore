# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
ENV/

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# Git
.git/
.gitignore
.gitattributes

# Documentation
*.md

# Data files (will be volumes)
# Environment files are deployment inputs and must never enter image layers.
.env
.env.*
*.db
*.json
*.sql
*.csv
logs/
backups/
data/
secrets/
instance/
docker-data/
*.log

# Tests
tests/
*.test.py
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Docker
Dockerfile
.dockerignore
docker-compose*.yml
nginx/
certs/

# Gemini config
.gemini/
.claude/

# OS
.DS_Store
Thumbs.db

# Frontend build output is produced in its dedicated Docker stage.
frontend/node_modules/
frontend/dist/

# The generic data-file rule above excludes JSON. These are source manifests
# required by the frontend build stage, not application data.
!frontend/*.json
